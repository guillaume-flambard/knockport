{
  "name": "knockport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && pnpm --filter @knockport/web exec tsc --noEmit",
    "audit": "pnpm run audit:full",
    "audit:full": "node scripts/audit-deps.mjs && pnpm typecheck && pnpm test",
    "audit:deps": "node scripts/audit-deps.mjs",
    "gen:content": "node scripts/gen-content.mjs",
    "seed": "KNOCKPORT_DB=$PWD/data/knockport.db node scripts/seed-demo.ts",
    "build:terminal": "esbuild packages/terminal/src/main.ts --bundle --minify --format=esm --target=es2022 --outfile=apps/web/public/terminal/main.js && cp packages/terminal/src/main.css apps/web/public/terminal/main.css",
    "watch:terminal": "esbuild packages/terminal/src/main.ts --bundle --format=esm --target=es2022 --outfile=apps/web/public/terminal/main.js --watch",
    "build": "pnpm build:terminal && pnpm --filter @knockport/web build",
    "dev": "pnpm build:terminal && KNOCKPORT_DB=$PWD/data/knockport.db pnpm --filter @knockport/web dev",
    "start": "KNOCKPORT_DB=$PWD/data/knockport.db pnpm --filter @knockport/web start"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
